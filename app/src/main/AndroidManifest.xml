<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_zh"
        android:name=".MoshiApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moshi">
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <activity
            android:name=".activities.launchPage.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.firstLaunchPage.FirstLaunchActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.mainPage.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.detailPage.DetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.searchPage.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ocrPage.OcrActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.textPage.TextActivity"
            android:exported="true"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.sharePage.ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.graphPage.GraphActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.lockPage.LockActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.voicePage.VoiceActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.cloudPage.CloudActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.privacyPage.PrivacyActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.privacyPage.StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.privacyPage.ModelActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.licensePage.LicenseActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.policyPage.PolicyActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.helpPage.HelpActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.tagPage.TagActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>