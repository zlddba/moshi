<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_zh"
        android:name=".MoshiApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moshi">
        <activity
            android:name=".activities.launchPage.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.firstLaunchPage.FirstLaunchActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.mainPage.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.detailPage.DetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ocrPage.OcrActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.voicePage.VoiceActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.cloudPage.CloudActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.privacyPage.PrivacyActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.privacyPage.StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.privacyPage.ModelActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.licensePage.LicenseActivity"
            android:exported="false"
            android:theme="@style/Theme.Moshi"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>